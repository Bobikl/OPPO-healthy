<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/device_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/device_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingStart="24dp" android:paddingEnd="12dp">
        <TextView android:id="@+id/device_toolbar_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/device_page_title" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/device_text" android:maxLines="1" android:ellipsize="end"/>
        <ImageButton android:id="@+id/device_manage" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/device_row_press" android:src="@drawable/device_plus" android:contentDescription="@string/device_manage"/>
    </LinearLayout>
    <ScrollView android:id="@+id/device_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/device_page_margin" android:paddingEnd="@dimen/device_page_margin" android:paddingBottom="28dp">
            <LinearLayout android:id="@+id/device_hero" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="10dp" android:paddingBottom="30dp">
                <com.example.opponotificationrelay.DeviceHeroView android:id="@+id/device_appearance" android:layout_width="240dp" android:layout_height="272dp"/>
                <TextView android:id="@+id/device_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="12dp" android:textSize="25sp" android:textStyle="bold" android:textColor="@color/device_text"/>
                <TextView android:id="@+id/device_connection" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="10dp" android:textSize="13sp" android:textColor="@color/device_secondary"/>
                <TextView android:id="@+id/device_metrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="8dp" android:text="@string/device_unknown_metrics" android:textSize="12sp" android:textColor="@color/device_secondary"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/device_primary_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/device_card"/>
            <LinearLayout android:id="@+id/device_health_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:background="@drawable/device_card"/>
            <LinearLayout android:id="@+id/device_secondary_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:background="@drawable/device_card"/>
            <TextView android:id="@+id/device_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:textSize="11sp" android:textColor="#777777"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
